---
import { useT, href, basePath, langs, type Lang } from '../i18n/ui.ts';
import OpenStatus from './OpenStatus.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const here = basePath(Astro.url.pathname);
const links = [
  ['/menu', t('nav.menu')], ['/order-cake', t('nav.order')], ['/catering', t('nav.catering')],
  ['/about', t('nav.about')], ['/visit', t('nav.visit')],
] as const;
const current = (p: string) => (here === p ? 'page' : undefined);
---
<header class="site-header" data-header>
  <div class="wrap header-row">
    <a class="brand" href={href(lang, '/')} aria-label="Naked Cakes, home">
      <img src="/brand/logo.svg" alt="" width="132" height="74" fetchpriority="low" />
    </a>
    <nav class="nav-desktop" aria-label={t('nav.label')}>
      <ul>{links.map(([p, label]) => <li><a href={href(lang, p)} aria-current={current(p)}>{label}</a></li>)}</ul>
    </nav>
    <div class="header-tools">
      <OpenStatus lang={lang} />
      <div class="lang-switch lang-desktop" role="group" aria-label={t('nav.lang')}>
        {langs.map((l) => (
          <a href={href(l, here)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
            <span aria-hidden="true">{l.toUpperCase()}</span><span class="sr-only">{({ en: 'English', nl: 'Nederlands', fr: 'Français' })[l]}</span>
          </a>
        ))}
      </div>
      <details class="mnav" data-mnav>
        <summary aria-label={t('nav.open')}><span></span></summary>
        <div class="mnav-panel grid-paper">
          <nav aria-label={t('nav.label')}>
            <ul>
              {[...links, ['/sweet-bite-club', t('nav.club')] as const].map(([p, label], i) => (
                <li style={`--i:${i}`}><a class="big" href={href(lang, p)} aria-current={current(p)}>{label}<span aria-hidden="true">&rarr;</span></a></li>
              ))}
            </ul>
          </nav>
          <a class="btn" href={href(lang, '/order-cake')}>{t('cta.order')}</a>
          <div class="lang-switch" style="width:fit-content;margin-top:var(--space-6)" role="group" aria-label={t('nav.lang')}>
            {langs.map((l) => (
              <a href={href(l, here)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                <span aria-hidden="true">{l.toUpperCase()}</span><span class="sr-only">{({ en: 'English', nl: 'Nederlands', fr: 'Français' })[l]}</span>
              </a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
