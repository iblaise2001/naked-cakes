---
import '../styles/global.css';
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { useT, href, htmlLang, langs, basePath, type Lang } from '../i18n/ui.ts';
import { business, banner, mapsLinks } from '../data/business.ts';
import { localBusinessLd } from '../lib/seo.ts';

interface Props {
  lang: Lang; title: string; description: string; ogImage?: string; jsonLd?: object[];
  breadcrumb?: { name: string; path: string }[]; showClub?: boolean; noindex?: boolean; preloadImage?: { srcset: string; type: string; sizes: string };
}
const { lang, title, description, ogImage = 'home', jsonLd = [], breadcrumb, showClub = true, noindex = false } = Astro.props;
const t = useT(lang);
const path = basePath(Astro.url.pathname);
const site = Astro.site!.toString().replace(/\/$/, '');
const canonical = site + href(lang, path);
const og = `${site}/og/${ogImage}.jpg`;
const ld: object[] = [localBusinessLd(site, lang), ...jsonLd];
if (breadcrumb) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Naked Cakes', path: '/' }, ...breadcrumb].map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: site + href(lang, b.path) })),
  });
}
const speculation = { prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }], prefetch: [{ where: { selector_matches: 'nav a, .btn, .action-bar a' }, eagerness: 'eager' }] };
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={site + href(l, path)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={site + href('en', path)} />}
    <link rel="preload" href={antonWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#E03189" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Naked Cakes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={htmlLang[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
    {ld.map((o) => <script type="application/ld+json" is:inline set:html={JSON.stringify(o)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    {banner.active && <p class="banner"><span aria-hidden="true">&#10022;</span> {banner[lang]}</p>}
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} showClub={showClub} />
    <nav class="action-bar" aria-label={t('nav.quick')}>
      <a href={href(lang, '/menu')}><Icon name="menu" />{t('nav.menu')}</a>
      <a class="primary" href={href(lang, '/order-cake')}><Icon name="cake" />{t('nav.order')}</a>
      <a href={mapsLinks.google} rel="noopener"><Icon name="pin" />{t('cta.directions')}</a>
    </nav>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
