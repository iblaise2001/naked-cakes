# Copy to .env for local work, set the same keys as Cloudflare Pages secrets in production.
# Never commit real values.

# Public site URL used for canonical links, sitemap and Open Graph (build time).
SITE_URL=https://naked-cakes.pages.dev

# Form delivery. "preview" validates and accepts submissions but sends nothing (current build).
MAIL_MODE=preview

# Transactional email (when MAIL_MODE=resend). Owner summary + customer confirmation.
RESEND_API_KEY=
MAIL_FROM="Naked Cakes <yummy@nakedcakes.be>"
MAIL_OWNER=yummy@nakedcakes.be

# Sweet Bite Club newsletter (double opt-in list provider).
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# Spam protection (Cloudflare Turnstile, invisible mode). Optional in preview.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
